{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "@atolljs/core": ["./src/sdk/index.ts"],
      "@atolljs/core/sdk": ["./src/sdk/index.ts"],
      "@atolljs/core/sdk/*": ["./src/sdk/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
