{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "webworker"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@atolljs/nextjs": [
        "../../packages/nextjs/src/index.ts"
      ],
      "@atolljs/react": [
        "../../packages/react/src/index.ts"
      ],
      "@atolljs/devtools": [
        "../../packages/devtools/src/index.ts"
      ],
      "@atolljs/devtools/*": [
        "../../packages/devtools/src/*"
      ],
      "@atolljs/incidents": [
        "../../packages/incidents/src/index.ts"
      ],
      "@atolljs/incidents/*": [
        "../../packages/incidents/src/*"
      ],
      "@atolljs/node": [
        "../../packages/node/src/index.ts"
      ],
      "@atolljs/node/*": [
        "../../packages/node/src/*"
      ],
      "@atolljs/core": [
        "../../src/index.ts"
      ],
      "@atolljs/core/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
