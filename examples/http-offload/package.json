{
  "name": "atoll-example-http-offload",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run bundle && tsx src/main.ts",
    "bundle": "esbuild src/offload.worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/offload.worker.js",
    "build": "tsc --noEmit && npm run bundle",
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
