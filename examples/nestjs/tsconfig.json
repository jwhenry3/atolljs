{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@atolljs/core": ["../../src/index.ts"],
      "@atolljs/core/*": ["../../src/*"],
      "@atolljs/incidents": ["../../packages/incidents/src/index.ts"],
      "@atolljs/incidents/*": ["../../packages/incidents/src/*"],
      "@atolljs/nestjs": ["../../packages/nestjs/src/index.ts"],
      "@atolljs/nestjs/*": ["../../packages/nestjs/src/*"],
      "@atolljs/node": ["../../packages/node/src/index.ts"],
      "@atolljs/node/*": ["../../packages/node/src/*"],
      "@nestjs/common": ["./node_modules/@nestjs/common"],
      "@nestjs/core": ["./node_modules/@nestjs/core"]
    }
  },
  "include": ["src", "test"]
}
