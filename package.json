{
  "name": "@jwhenry123/mesh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk/*": "./src/sdk/*",
    "./react": "./packages/react/src/index.ts",
    "./vue": "./packages/vue/src/index.ts",
    "./solidjs": "./packages/solidjs/src/index.ts",
    "./svelte": "./packages/svelte/src/index.ts",
    "./angular": "./packages/angular/src/index.ts",
    "./nextjs": "./packages/nextjs/src/index.ts",
    "./incidents": "./packages/incidents/src/index.ts"
  },
  "files": [
    "dist",
    "src/sdk",
    "packages/*/src"
  ],
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "kill:all": "node scripts/kill-all.mjs",
    "serve:all": "node scripts/serve-all.mjs",
    "serve:docs": "node scripts/serve-docs.mjs",
    "build": "tsc --noEmit && vite build && vite build --config vite.app.config.ts",
    "test": "vitest run",
    "build:pages": "node scripts/build-pages.mjs",
    "assemble:pages": "node scripts/assemble-pages.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "fast-json-stringify": "^7.0.1",
    "msgpackr": "^2.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.15",
    "zod": "^4.6.5"
  }
}
