{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@atolljs/core": ["../../src/index.ts"],
      "@atolljs/core/*": ["../../src/*"],
      "@atolljs/devtools": ["./src/index.ts"],
      "@atolljs/devtools/*": ["./src/*"]
    }
  },
  "include": ["src", "test"]
}
