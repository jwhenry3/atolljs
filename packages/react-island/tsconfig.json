{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "@atolljs/core": ["../../src/index.ts"],
      "@atolljs/core/*": ["../../src/*"],
      "@atolljs/islands": ["../../packages/islands/src/index.ts"],
      "@atolljs/islands/*": ["../../packages/islands/src/*"]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
