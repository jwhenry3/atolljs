{
  "name": "@atolljs/cli",
  "version": "0.1.3",
  "description": "atoll — scaffold worker pools, shared-memory contracts, and framework islands (experimental)",
  "homepage": "https://jwhenry3.github.io/atolljs/consumer/quickstart/",
  "type": "module",
  "bin": {
    "atoll": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --format=esm --platform=node --target=node20.12 --outfile=dist/cli.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhenry3/atolljs",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/jwhenry3/atolljs/issues"
  },
  "license": "MIT"
}
