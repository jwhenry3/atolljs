{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // Sources are TypeScript run via Node's type stripping in dev and
    // bundled to dist/cli.js at publish time — relative imports keep
    // explicit .ts extensions so both paths work.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
