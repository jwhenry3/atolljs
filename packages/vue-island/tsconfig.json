{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    // islands's worker entry re-exports a .tsx module (worker/slot.tsx).
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@atolljs/core/sdk": ["../../src/sdk/index.ts"],
      "@atolljs/core/sdk/*": ["../../src/sdk/*"],
      "@atolljs/islands": ["../../packages/islands/src/index.ts"],
      "@atolljs/islands/*": ["../../packages/islands/src/*"]
    }
  },
  "include": [
    "src",
    "test",
    // The test fixture imports the worker entry, which imports
    // react-reconciler — islands's ambient module declaration.
    "../../packages/islands/src/react-reconciler.d.ts"
  ]
}
