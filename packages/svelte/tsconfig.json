{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@atolljs/core": ["../../src/index.ts"],
      "@atolljs/core/*": ["../../src/*"]
    },
    // Rune globals ($state, $effect) come from svelte's ambient types —
    // resolved from the root node_modules so a publishable package doesn't
    // depend on an example app's install.
    "types": ["svelte"]
  },
  "include": ["src", "test"]
}
