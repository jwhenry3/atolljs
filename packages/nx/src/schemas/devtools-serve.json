{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atoll-devtools",
  "title": "atoll devtools — serve the dashboard",
  "type": "object",
  "properties": {
    "port": {
      "type": "number",
      "default": 4780,
      "description": "Port for the local devtools server."
    },
    "otlp": {
      "type": "string",
      "description": "OpenTelemetry OTLP/HTTP endpoint — forwards every session."
    },
    "otlpHeaders": {
      "type": "string",
      "description": "Extra OTLP headers, k=v,k2=v2 (OTEL_EXPORTER_OTLP_HEADERS format)."
    },
    "otlpService": {
      "type": "string",
      "description": "service.name attached to forwarded OTLP sessions."
    }
  }
}
