{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "@atolljs/core/sdk": ["../../src/sdk/index.ts"],
      "@atolljs/core/sdk/*": ["../../src/sdk/*"]
    }
  },
  "include": ["src", "test"]
}
